{
	"name": "@nstechhub/corporate-auth-policies",
	"version": "0.2.0",
	"description": "Políticas corporativas de autenticação JWT + Keycloak com Problem Details e ErrorCode padrão NSTech",
	"main": "dist/cjs/index.js",
	"module": "dist/esm/index.js",
	"exports": {
		".": {
			"require": "./dist/cjs/index.js",
			"import": "./dist/esm/index.js"
		},
		"./package.json": "./package.json"
	},
	"types": "dist/esm/index.d.ts",
	"scripts": {
		"build": "tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json",
		"test": "vitest run --coverage",
		"test:watch": "vitest",
		"type-check": "tsc --noEmit"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/nstechhub/corporate-auth-policies.git"
	},
	"publishConfig": {
		"registry": "https://npm.pkg.github.com"
	},
	"dependencies": {
		"jsonwebtoken": "^9.0.3",
		"jwks-rsa": "^3.2.2"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.13",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^25.1.0",
		"@vitest/coverage-v8": "^4.0.18",
		"@vitest/ui": "^4.0.18",
		"nodemon": "^3.1.11",
		"typescript": "^5.9.3",
		"vitest": "^4.0.18"
	},
	"volta": {
		"node": "24.13.0"
	}
}
