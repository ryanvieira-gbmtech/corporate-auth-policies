{
  "name": "@nstechhub/corporate-auth-policies",
  "version": "0.1.0",
  "description": "Políticas corporativas de autenticação JWT + Keycloak com Problem Details e ErrorCode padrão NSTech",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:ui-open": "vitest --ui --open",
    "dashboard": "node scripts/start-dashboard.js",
    "dashboard:dev": "nodemon scripts/start-dashboard.js",
    "test:coverage": "vitest run --coverage",
    "test:basic": "vitest run tests/JwtValidator.basic.spec.ts",
    "test:audience": "vitest run tests/JwtValidator.audience.spec.ts",
    "test:role": "vitest run tests/JwtValidator.role.spec.ts",
    "test:problem-details": "vitest run tests/ProblemDetails.spec.ts",
    "test:types": "vitest run tests/types.spec.ts",
    "test:integration": "vitest run tests/integration.spec.ts",
    "type-check": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nstechhub/corporate-auth-policies.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "dependencies": {
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.1.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.0.15",
    "@vitest/ui": "^4.0.15",
    "typescript": "^5.3.3",
    "vitest": "^4.0.15",
    "nodemon": "^3.0.1"
  }
}